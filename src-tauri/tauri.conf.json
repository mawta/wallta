{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallta", "version": "0.1.0", "identifier": "app.wallta.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Wallta", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; connect-src ipc: http://ipc.localhost https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:", "assetProtocol": { "enable": true, "scope": ["$APPCACHE/media/**"] } }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "shortDescription": "Your wallpaper, on your rhythm", "windows": { "nsis": { "displayLanguageSelector": false } } }
}
